# 이 파일을 .env.local 로 복사해 값을 채우세요. .env.local 은 절대 커밋하지 마세요.
# (이 파일에는 자리표시자만 둡니다. 실제 비밀 값을 넣지 마세요.)

# MongoDB Atlas 연결 문자열 (데이터는 `todo` DB 에 저장됩니다)
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority

# GitHub OAuth App (GitHub > Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=<OAuth App 의 Client ID>
GITHUB_CLIENT_SECRET=<OAuth App 의 Client secret — 서버에서만 읽으며 소스에 넣지 않습니다>

# 앱의 공개 주소 (끝에 / 없이). OAuth 콜백 주소 기준이 됩니다.
# 로컬: http://localhost:3000 / 배포: https://<your-domain>  (운영에서는 필수)
APP_URL=http://localhost:3000
